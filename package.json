{
  "name": "qualified-opinion-discovery",
  "version": "0.1.0",
  "private": true,
  "description": "Country-agnostic discovery and human review of source-linked public opinions",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": { "bun": ">=1.3.14" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "check": "bun run typecheck && bun test && bun run publication:check",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "demo": "bun apps/worker/src/demo.ts",
    "discovery": "bun apps/worker/src/cli.ts",
    "publication:check": "bun scripts/check-publication.ts",
    "publication:snapshot": "bun scripts/snapshot-publication.ts",
    "licenses": "bun scripts/dependency-licenses.ts",
    "format": "bun ./node_modules/@biomejs/biome/bin/biome format --write .",
    "format:check": "bun ./node_modules/@biomejs/biome/bin/biome format ."
  },
  "devDependencies": {
    "@discovery/ai": "workspace:*",
    "@discovery/config": "workspace:*",
    "@discovery/crawler": "workspace:*",
    "@discovery/store": "workspace:*",
    "@discovery/worker": "workspace:*",
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
